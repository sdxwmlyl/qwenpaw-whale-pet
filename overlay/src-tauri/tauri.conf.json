{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhalePet",
  "version": "0.1.1",
  "identifier": "com.qwenpaw.whalepet",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "鲸鱼娘",
        "url": "index.html",
        "width": 240,
        "height": 280,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "sdxwmlyl",
    "shortDescription": "QwenPaw 鲸鱼娘桌宠",
    "longDescription": "QwenPaw desktop pet overlay: tool-aware poses, stats, token report and sound alerts.",
    "resources": [
      "../bridge.py"
    ]
  }
}